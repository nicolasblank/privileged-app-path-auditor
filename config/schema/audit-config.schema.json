{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "audit-config.schema.json",
  "title": "Auditor runtime configuration",
  "type": "object",
  "required": ["version", "stalePrivilege", "filters", "consentRisk", "credentialHygiene", "output"],
  "properties": {
    "$schema": { "type": "string" },
    "description": { "type": "string" },
    "version": { "type": "string" },
    "lastUpdated": { "type": "string", "format": "date" },
    "stalePrivilege": {
      "type": "object",
      "required": ["inactiveDays"],
      "properties": { "inactiveDays": { "type": "integer", "minimum": 1 }, "description": { "type": "string" } },
      "additionalProperties": false
    },
    "filters": {
      "type": "object",
      "required": ["excludeDisabledApps", "excludeFirstPartyMicrosoftApps", "excludeAppIds"],
      "properties": {
        "excludeDisabledApps": { "type": "boolean" },
        "excludeFirstPartyMicrosoftApps": { "type": "boolean" },
        "excludeAppIds": { "type": "array", "items": { "type": "string", "format": "uuid" } },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "consentRisk": {
      "type": "object",
      "required": ["flagUserConsentedApps"],
      "properties": { "flagUserConsentedApps": { "type": "boolean" }, "description": { "type": "string" } },
      "additionalProperties": false
    },
    "credentialHygiene": {
      "type": "object",
      "required": ["preferredCredentialTypes", "riskyCredentialTypes", "flagMultipleCredentials", "flagExpiredCredentials"],
      "properties": {
        "preferredCredentialTypes": { "type": "array", "items": { "enum": ["Certificate", "Federated", "Secret", "SP-Secret", "SP-Certificate"] }, "uniqueItems": true },
        "riskyCredentialTypes": { "type": "array", "items": { "enum": ["Certificate", "Federated", "Secret", "SP-Secret", "SP-Certificate"] }, "uniqueItems": true },
        "flagMultipleCredentials": { "type": "boolean" },
        "flagExpiredCredentials": { "type": "boolean" },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": ["maxUsersInRoleAuditList", "truncateAfter"],
      "properties": {
        "maxUsersInRoleAuditList": { "type": "integer", "minimum": 1 },
        "truncateAfter": { "type": "integer", "minimum": 1 },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
